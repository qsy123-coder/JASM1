<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GIMI_ModManager.WinUI.Views.DailyUpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GIMI_ModManager.WinUI.Models"
    xmlns:views="using:GIMI_ModManager.WinUI.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />

        <!-- 卡片版式：**复制**自 ModMarketPage 的 ModCardTemplate，改一处必须改另一处。
             尺寸是照商店那份参考图量出来的（卡片外框 304 那一套），由 code-behind 的 CardScaler
             按槽位宽整体等比缩放，所以「图片区高度」这一处改动是唯一的例外 ——

             ⚠️ **图片区 380（≈4:5），与市场的 540（9:16）不同**。市场用 9:16 是因为它的预览图
             实测中位数就是 750×1268（≈9:16），铺满不留边。但那是"一屏看 6 个"的浏览壁纸，
             代价是每张卡高达 750px —— 放到"每日更新"这种要看量的页面上，一屏只能站下 6~8 个。
             wave-mod 站点的每日更新页自己也是压到 `aspect-[4/5]` 的（updates-grid.tsx），
             这里跟它一致。比例不一致的图由下面那层模糊背景兜底，不会露出两条纯色。

             ⚠️ 这已经是第三份（ModStorePage / ModMarketPage / 这里）。ModStorePage.CardScaler 的注释里
             写着「等第三处调用者出现再抽公共件」—— 时机到了，但那是一次独立的改动（要动两个已验证的
             页面），不夹在这个功能里做。在那之前，这里除图片区高度外的改动都要同步回 ModMarketPage。 -->
        <DataTemplate x:Key="ModCardTemplate">
            <Border Margin="13,25,13,25" Background="White" CornerRadius="12"
                    BorderBrush="#E8EBED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 行0: 图片区。380 ≈ 卡片内宽 304 × 5/4 —— 4:5 竖屏(与 wave-mod 每日更新页一致,
                         比市场的 9:16 矮一截,一屏能多站几排)。由 CardScaler 随整卡等比缩放,
                         任何窗口宽度下这个比例都不变。 -->
                    <Grid x:Name="ThumbHost" Grid.Row="0" Height="380">
                        <!-- 层0: 无图片时的纯色占位背景 -->
                        <Grid Background="#2A2A2A" />
                        <!-- 层1: 模糊背景 —— **同一张预览图**铺满。图片区做成 4:5 之后,比例一致的图不会有边,
                             这层是给**比例不一致的那些**兜底的(市场里的竖图是 9:16,比 4:5 更瘦,两边必然留边):
                             它们剩的那点边仍然填成图的延伸,而不是两条纯色。
                             做法是把同一张图按极低分辨率解码(DecodePixelWidth=16)再拉满卡片宽:双线性插值
                             出来就是一片柔和色块,视觉上等同模糊。 -->
                        <Image x:Name="CardImageBackdrop" Stretch="UniformToFill" />
                        <!-- 层2: 只压一点点(20%),让模糊背景比主图略沉、但**必须看得出来是图** -->
                        <Grid Background="#33000000" />
                        <!-- 层3: 图片加载动画(滚动到视口才开始加载,离屏折叠,不空转) -->
                        <ProgressRing x:Name="CardLoadingRing" IsActive="False"
                                      Visibility="Collapsed"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="#0078D4" />
                        <!-- 层4: 整张预览图完整显示(Source 由代码在滚到视口时设置) -->
                        <Image x:Name="CardImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ImageOpened="CardImage_Opened" ImageFailed="CardImage_Failed" />
                        <!-- 层5: NSFW 角标(右上,同商店样式) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12" Padding="8,3" Background="#E93A45"
                                CornerRadius="8"
                                Visibility="{Binding Nsfw, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" Text="NSFW" />
                        </Border>
                    </Grid>

                    <!-- 行1: 信息块 —— 五段**定高行**(标题 54 / 空档 18 / 作者行 25 / 空档 9 / 统计行 24),
                         加内边距 17+14 正好 161。定高是为了「同一行的卡片下边缘齐」。 -->
                    <Grid Grid.Row="1" Padding="17,17,17,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="#1B1B1B" FontWeight="SemiBold" FontSize="20"
                                   LineHeight="27" LineStackingStrategy="BlockLineHeight"
                                   MaxLines="2" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />

                        <!-- 作者行:版式照商店(头像圆 + 中间一栏 + 右侧相对时间),中间那栏放**角色名** ——
                             市场的接口里没有作者名,只有 mod_author_url 这个链接。 -->
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="25" Height="25" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="17"
                                       Foreground="#606061" Text="{Binding Character}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16"
                                       Foreground="#8C8C8D" Text="{Binding RelativeTime}" />
                        </Grid>

                        <!-- 统计三项:点赞 / 浏览 / 评论(顺序、图标、配色都与商店一致) -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- EB51 是空心心形(EB52 是实心的) -->
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xEB51;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding LikesCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xE890;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding Views}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xE8F2;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding CommentsCount}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- NSFW 模糊遮罩:盖住**整张卡**(含下面的信息块),点一下就地揭开。
                         放在最后 = 盖在最上层。本页不做内容筛选,这个遮罩默认不显示
                         (IsNsfwBlurred 恒为 false),但模板与市场共用同一份,留着以免两处版式分叉。 -->
                    <Border Grid.RowSpan="2" CornerRadius="12"
                            Visibility="{Binding IsNsfwBlurred, Converter={StaticResource BoolToVisibilityConverter}}"
                            Tapped="NsfwOverlay_Tapped" IsTapEnabled="True">
                        <Grid>
                            <Image Source="ms-appx:///Assets/66d9ecdd7558593ef412e76fc3582eb4.jpg"
                                   Stretch="UniformToFill" Opacity="0.92" />
                            <Border Background="#40000000">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F51E;" FontSize="28"
                                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="NSFW 内容已隐藏" Foreground="White" FontSize="12"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="点击查看" Foreground="#CCCCCC" FontSize="10"
                                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头:返回 + 标题 + 窗口说明 + 刷新。
             返回按钮是本页自己要的 —— 外壳导航栏上那个离内容太远,而这一页是从市场里点进来的,
             用户的心智是"进了一个子页",就地给一个回去的口子。走 Frame 的返回栈,回到市场页。 -->
        <Grid Grid.Row="0" Padding="20,14,20,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" VerticalAlignment="Center" CornerRadius="6" Padding="10,6"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回 Mod 市场">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    <TextBlock Text="返回" FontSize="14" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="每日更新" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="最近 7 天新增的 Mod，按上传日期分组" FontSize="12" Margin="0,2,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="2" VerticalAlignment="Center" CornerRadius="6"
                    Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <!-- 左:日期导航。只有**有更新的天**才进去,点一下滚到那一段,滚动时高亮跟着走
                     (与 wave-mod 的 daily-update-pills.tsx 同一条交互)。 -->
                <ColumnDefinition Width="184" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 用 ListView 而不是一列 Button:选中/悬停的视觉是现成的,滚动高亮只要换 SelectedItem。
                 自己拿 Button.Background 做高亮会被模板的 VisualState 动画盖掉(悬停结束会回落到主题底色,
                 而不是我们设的那份)。样式照左侧分类栏那份(ListViewItem 的 Padding/Margin/CornerRadius)。 -->
            <ListView x:Name="DayNavListView" Grid.Column="0"
                      SelectionMode="Single"
                      Padding="16,0,6,16"
                      SelectionChanged="DayNav_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DailyUpdateGroup">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ShortLabel}"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind NavCount}"
                                       FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 降级横幅:Supabase 网关不可用时,下面的数据来自 COS 兜底快照。
                     必须放在内容区**外面**这一层 —— 它不能塞进"初始加载"面板(那个在加载完成后整体收起)。 -->
                <InfoBar Grid.Row="0"
                         IsClosable="False"
                         Severity="Warning"
                         Title="离线快照模式"
                         Message="{x:Bind ViewModel.DegradedMessage, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.IsDegraded, Mode=OneWay}" />

                <!-- 截断提示:窗口内的更新超过一次请求的上限时明说,不静默少给一截。 -->
                <InfoBar Grid.Row="1"
                         IsClosable="False"
                         Severity="Informational"
                         Title="仅显示部分结果"
                         Message="{x:Bind ViewModel.TruncatedMessage, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.IsTruncated, Mode=OneWay}" />

                <Grid Grid.Row="2">
                    <!-- 分节容器:每个日期节一个标题 + 一个卡片面板,由 code-behind 在每次加载后整体重建。 -->
                    <ScrollViewer x:Name="CardScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Top"
                                  ViewChanged="ScrollViewer_ViewChanged">
                        <StackPanel x:Name="GroupsPanel" Padding="0,0,0,24" VerticalAlignment="Top" />
                    </ScrollViewer>

                    <!-- 加载指示器:仅在还没有任何分节时显示(重载时旧内容已被清掉,所以等价于"首次/刷新")。 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                                Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   HorizontalAlignment="Center" Margin="0,4" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 空状态 / 失败。文案绑 EmptyStateMessage(而不是写死):加载失败时这里显示失败原因 + 重试。 -->
                    <Grid Background="#F5F7FA"
                          Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}" />
                            <Button Content="重试" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    CornerRadius="6"
                                    Command="{x:Bind ViewModel.RefreshCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Mod 详情抽屉:与市场共用同一个控件,打开行为也一致(点卡片 → Show(mod))。 -->
        <views:ModDetailPanel x:Name="DetailPanel" Grid.RowSpan="2" />
    </Grid>
</Page>
