<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GIMI_ModManager.WinUI.Views.ModMarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GIMI_ModManager.WinUI.Views.Controls"
    xmlns:views="using:GIMI_ModManager.WinUI.Views"
    xmlns:models="using:GIMI_ModManager.WinUI.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter
            x:Key="BoolToVisibilityConverter"
            TrueValue="Visible"
            FalseValue="Collapsed" />
        <DataTemplate x:Key="CategoryItemTemplate" x:DataType="models:ModMarketCategory">
            <Grid Padding="12,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14">
                    <Grid>
                        <FontIcon FontSize="15" Glyph="&#xE8FD;"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Width="28" Height="28" Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="28" UriSource="{x:Bind ImageUri}" />
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                           Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ModCount}" />
            </Grid>
        </DataTemplate>

        <!-- 卡片版式:与 Mod 商店**逐值同款** —— 图片在上、白色信息块在下,一行 6 个;
             所有尺寸都是照商店那份参考图量出来的设计值(卡片外框 304×360、封面高 195、信息块高 161),
             由 code-behind 的 CardScaler 按槽位宽整体等比缩放(字号/内边距/行高一起走),
             这样任何窗口宽度下卡片比例都和商店一致。改这里的尺寸不用动代码,缩放会自己跟上。

             与商店的差别只有**图片区**这一处,而且是**照着市场自己的数据定的**:
             实测市场里的预览图中位数是 750×1268(宽高比 0.562 ≈ 9:16),而商店那份封面区是横向的
             (304×195,还用 UniformToFill 裁切)。这里就把图片区做成 **9:16**(304 宽 × 540 高),
             于是竖图正好铺满、两边不留边 —— 卡片的其余部分(白底、信息块、列数、缩放)与商店完全一致。 -->
        <DataTemplate x:Key="ModCardTemplate">
            <Border Margin="13,25,13,25" Background="White" CornerRadius="12"
                    BorderBrush="#E8EBED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 行0: 图片区。540 = 卡片内宽 304 × 16/9 —— 9:16 竖屏,与预览图的比例一致,
                         所以图正好铺满。由 CardScaler 随整卡等比缩放,任何窗口宽度下这个比例都不变。 -->
                    <Grid x:Name="ThumbHost" Grid.Row="0" Height="540">
                        <!-- 层0: 无图片时的纯色占位背景 -->
                        <Grid Background="#2A2A2A" />
                        <!-- 层1: 模糊背景 —— **同一张预览图**铺满。图片区做成 9:16 之后,比例一致的图不会有边,
                             这层是给**比例不一致的那几张**(实测有 0.51~0.64、甚至一张 2.9 的宽图)兜底的:
                             它们剩的那点边仍然填成图的延伸,而不是两条纯色。
                             做法是把同一张图按极低分辨率解码(DecodePixelWidth=16)再拉满卡片宽:双线性插值
                             出来就是一片柔和色块,视觉上等同模糊。WinUI 3 的 XAML 没有给任意元素用的模糊效果
                             (Composition 那套得引 Win2D),这是零依赖的等价做法。
                             Source 与主图一起在滚到视口时设,见页面 code-behind;它不挂 ImageOpened ——
                             十几像素的解码几乎瞬间完成,挂上去会把加载圈提前收掉。 -->
                        <Image x:Name="CardImageBackdrop" Stretch="UniformToFill" />
                        <!-- 层2: 只压一点点(20%),让模糊背景比主图略沉、但**必须看得出来是图** ——
                             之前压了 35% 又叠 55% 透明,最终亮度只剩三成多,深色截图看上去就是一条纯色 ✗ -->
                        <Grid Background="#33000000" />
                        <!-- 层3: 图片加载动画(滚动到视口才开始加载,离屏折叠,不空转) -->
                        <ProgressRing x:Name="CardLoadingRing" IsActive="False"
                                      Visibility="Collapsed"
                                      Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="#0078D4" />
                        <!-- 层4: 整张预览图完整显示(Source 由代码在滚到视口时设置)。
                             不留内缩:图片区已经是 9:16,比例一致的图正好铺满、不该再留一圈边。 -->
                        <Image x:Name="CardImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ImageOpened="CardImage_Opened" ImageFailed="CardImage_Failed" />
                        <!-- 层5: NSFW 角标(右上,同商店样式) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="12" Padding="8,3" Background="#E93A45"
                                CornerRadius="8"
                                Visibility="{Binding Nsfw, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" Text="NSFW" />
                        </Border>
                    </Grid>

                    <!-- 行1: 信息块 —— 五段**定高行**(标题 54 / 空档 18 / 作者行 25 / 空档 9 / 统计行 24),
                         加内边距 17+14 正好 161,与商店逐段对齐。定高是为了「同一行的卡片下边缘齐」:
                         一行标题的卡片也占两行的高度。 -->
                    <Grid Grid.Row="1" Padding="17,17,17,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Foreground="#1B1B1B" FontWeight="SemiBold" FontSize="20"
                                   LineHeight="27" LineStackingStrategy="BlockLineHeight"
                                   MaxLines="2" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />

                        <!-- 作者行:版式照商店(头像圆 + 中间一栏 + 右侧相对时间),但中间那栏放**角色名** ——
                             市场的接口里没有作者名,只有 mod_author_url 这个链接(绑上去会是一串网址)。 -->
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="25" Height="25" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="17"
                                       Foreground="#606061" Text="{Binding Character}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16"
                                       Foreground="#8C8C8D" Text="{Binding RelativeTime}" />
                        </Grid>

                        <!-- 统计三项:点赞 / 浏览 / 评论(顺序、图标、配色都与商店一致) -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- EB51 是空心心形(EB52 是实心的) -->
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xEB51;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding LikesCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xE890;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding Views}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="20" Foreground="#3264A7" Glyph="&#xE8F2;"
                                          VerticalAlignment="Center" />
                                <TextBlock FontSize="16" Foreground="#808081" VerticalAlignment="Center"
                                           Text="{Binding CommentsCount}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- NSFW 模糊遮罩:市场特有(商店没有这一层),盖住**整张卡**(含下面的信息块,
                         与旧版行为一致),点一下就地揭开。放在最后 = 盖在最上层。 -->
                    <Border Grid.RowSpan="2" CornerRadius="12"
                            Visibility="{Binding IsNsfwBlurred, Converter={StaticResource BoolToVisibilityConverter}}"
                            Tapped="NsfwOverlay_Tapped" IsTapEnabled="True">
                        <Grid>
                            <Image Source="ms-appx:///Assets/66d9ecdd7558593ef412e76fc3582eb4.jpg"
                                   Stretch="UniformToFill" Opacity="0.92" />
                            <Border Background="#40000000">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F51E;" FontSize="28"
                                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="NSFW 内容已隐藏" Foreground="White" FontSize="12"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="点击查看" Foreground="#CCCCCC" FontSize="10"
                                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Grid Grid.Column="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="16,16,16,8" FontSize="18" FontWeight="Bold"
                       l:Uids.Uid="ModMarket_CategoriesTitle" Text="分类" />
            <ListView x:Name="CategoryListView" Grid.Row="1"
                      ItemTemplate="{StaticResource CategoryItemTemplate}"
                      ItemsSource="{x:Bind ViewModel.Categories}"
                      SelectionMode="Single"
                      SelectionChanged="CategoryListView_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Right Main Panel -->
        <Grid Grid.Column="1" Background="#F5F7FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" MinHeight="50" Padding="12,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索**不在输入时触发**：输入本身不发任何请求，只在按回车 / 点右边那个「搜索」按钮 /
                     清空时才重载。Text 仍是 PropertyChanged 双向绑定 —— "框里的字就是查询条件"，
                     不引入"已提交 / 未提交"两份状态（两份状态会带来"改了词、切个分类却搜的是旧词"这类更难解释的行为）。 -->
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         VerticalAlignment="Center" PlaceholderText="搜索模组..."
                         l:Uids.Uid="ModMarket_SearchPlaceholder"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown"
                         CornerRadius="6" Margin="0,0,8,0">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="White" />
                    </TextBox.Resources>
                    <!-- Ctrl+F 聚焦搜索框。挂在 TextBox 上、且用 Invoked 而不是 Command，
                         与角色详情页那处写法一致。 -->
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control"
                                             Invoked="SearchAccelerator_OnInvoked" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>

                <!-- 「搜索」按钮：与回车完全同义。做成独立按钮而不是输入框内嵌图标 —— 这一排本来
                     全是独立控件，它跟它们同高、同圆角、同间距，而且点起来大。 -->
                <Button Grid.Column="1" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                        Content="搜索"
                        CornerRadius="6"
                        Command="{x:Bind ViewModel.SearchCommand}" />

                <ComboBox Grid.Column="2" Width="110" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.CategoryFilterOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" />

                <ComboBox Grid.Column="3" Width="120" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.ContentFilterOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedContentFilter, Mode=TwoWay}" />

                <ComboBox Grid.Column="4" Width="100" VerticalAlignment="Center"
                          CornerRadius="6" Background="White" Margin="0,0,8,0"
                          ItemsSource="{x:Bind ViewModel.SortOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" />

                <!--  「每日更新」—— 最近 7 天有更新的 mod，按天分组，在应用内整页展示。
                      工具栏上一个纯文字按钮就够了:图标会让人以为是站内已有功能，而它是新开的一页。  -->
                <Button Grid.Column="5" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                        Content="每日更新"
                        CornerRadius="6"
                        Command="{x:Bind ViewModel.OpenDailyUpdatesCommand}" />

                <Button Grid.Column="6" Width="36" Height="36" VerticalAlignment="Center"
                        ToolTipService.ToolTip="下载管理" l:Uids.Uid="ModMarket_DownloadManager"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Command="{x:Bind ViewModel.OpenDownloadManagerCommand}">
                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 降级横幅:Supabase 网关不可用时,下面这些卡片来自 COS 兜底快照。
                     必须放在这一层 —— 不能塞进下面那个"初始加载"面板,它在非初始加载时整体 Collapsed,
                     而快照模式下滚动翻页时正是非初始加载状态。 -->
                <InfoBar Grid.Row="0"
                         IsClosable="False"
                         Severity="Warning"
                         Title="离线快照模式"
                         Message="{x:Bind ViewModel.DegradedMessage, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.IsDegraded, Mode=OneWay}" />

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="CardScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalContentAlignment="Top"
                                  ViewChanged="ScrollViewer_ViewChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 固定 6 列、宽度均分,与 Mod 商店一致(窗口窄到每列不足 180 时自动降列) -->
                            <local:WrapGridPanel x:Name="ModCardsPanel" Grid.Row="0"
                                                 VerticalAlignment="Top"
                                                 Columns="6" MinItemWidth="180" />
                            <!-- 滚动加载更多指示器:ScrollViewer 内部最底部,作为内容流末尾,Collapsed 时不占位 -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                        Margin="0,8,0,16"
                                        Visibility="{x:Bind ViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                                <TextBlock Text="正在加载更多..." HorizontalAlignment="Center"
                                           Margin="0,4" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 首次加载/重载指示器:仅初始加载时显示在顶部 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                                Visibility="{x:Bind ViewModel.IsInitialLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   HorizontalAlignment="Center" Margin="0,4" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 空状态。文案绑 EmptyStateMessage(而不是写死):加载失败时这里显示失败原因 + 重试,
                         之前失败只写了 StatusMessage,而那个文案仅在初始加载期间可见,结果是一片空白。 -->
                    <Grid Background="#F5F7FA"
                          Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}" />
                            <Button Content="重试" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    CornerRadius="6"
                                    Command="{x:Bind ViewModel.RefreshCommand}" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <!-- Mod Detail Panel overlay (spans sidebar + main) -->
        <views:ModDetailPanel x:Name="DetailPanel" Grid.ColumnSpan="2" />
    </Grid>
</Page>
